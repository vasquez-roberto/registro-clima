name: Actualizar Calidad del Aire Monterrey

on:
  schedule:
    # Se ejecuta cada 3 horas (Minuto 0, cada 3 horas)
    - cron: '0 */3 * * *'
  workflow_dispatch: # Permite ejecutar el proceso manualmente desde la web de GitHub

jobs:
  build-and-commit:
    runs-on: ubuntu-latest

    steps:
    - name: Clonar Repositorio
      uses: actions/checkout@v4

    - name: Configurar Python
      uses: actions/setup-python@v5
      with:
        python-version: '3.11'

    - name: Instalar Dependencias
      run: |
        python -m pip install --upgrade pip
        pip install -r requirements.txt

    - name: Ejecutar Extracción
      run: python main.py

    - name: Guardar Cambios en GitHub
      run: |
        git config --global user.name 'github-actions[bot]'
        git config --global user.email 'github-actions[bot]@users.noreply.github.com'
        git add data/calidad_aire.csv
        git commit -m "Automated update: Registros de calidad del aire Monterrey" || exit 0
        git push